#!/bin/bash
# Python 仓库 pre-commit 模板（源自 task2app 随机抽测策略）：
# 1) 优先运行暂存的 test_*.py / *_test.py
# 2) 对其余测例按比例随机抽测
# 3) 任一测试失败则阻止提交
# 可用 PRECOMMIT_PYTHON_TEST_ROOTS 覆盖扫描根（空格分隔，默认 "tests scripts ."）

set -u

cleanup() {
    echo "如果有测例失败，记得修复"
    echo "如果提交失败，记得先尝试修复，不行再忽略测例"
}
trap cleanup SIGINT SIGTERM EXIT

cd "$(dirname "$0")/../.." || exit 1

# 仅变更 hooks/文档时跳过抽测，便于自举提交钩子模板（非 --no-verify）
_bootstrap_staged="$(git diff --cached --name-only 2>/dev/null || true)"
if [ -n "$_bootstrap_staged" ]; then
    _only_hooks=1
    while IFS= read -r _f; do
        [ -z "$_f" ] && continue
        case "$_f" in
            scripts/hooks/*|.githooks/*|README.md) ;;
            *) _only_hooks=0; break ;;
        esac
    done <<< "$_bootstrap_staged"
    if [ "$_only_hooks" -eq 1 ]; then
        echo "Pre-commit bootstrap: only hooks/docs staged; skip random unit tests."
        exit 0
    fi
fi

echo "Running pre-commit Python tests in $(pwd)..."

export PRE_COMMIT=1
TEST_RATIO="${PRECOMMIT_TEST_RATIO:-30}"
ROOTS="${PRECOMMIT_PYTHON_TEST_ROOTS:-tests scripts .}"
STAGED_FILES="$(git diff --cached --name-only 2>/dev/null || true)"

collect_tests() {
    local root
    for root in $ROOTS; do
        [ -d "$root" ] || continue
        if [ "$root" = "." ]; then
            find . -maxdepth 3 -type f \( -name 'test_*.py' -o -name '*_test.py' \) \
                -not -path './.git/*' \
                -not -path './node_modules/*' \
                -not -path './venv/*' \
                -not -path './.venv/*' \
                -not -path './site-packages/*' \
                -not -path '*/__pycache__/*' \
                2>/dev/null
        else
            find "$root" -type f \( -name 'test_*.py' -o -name '*_test.py' \) \
                -not -path '*/__pycache__/*' \
                -not -path '*/venv/*' \
                -not -path '*/.venv/*' \
                2>/dev/null
        fi
    done | sed 's#^\./##' | sort -u
}

run_python_test() {
    local test_file="$1"
    if command -v python3 >/dev/null && python3 -c 'import pytest' 2>/dev/null; then
        echo "Running: python3 -m pytest $test_file -q"
        python3 -m pytest "$test_file" -q --tb=line
    else
        echo "Running: python3 $test_file"
        python3 "$test_file"
    fi
}

TMP_ALL="$(mktemp)"
TMP_STAGED="$(mktemp)"
TMP_TO_RUN="$(mktemp)"
trap 'rm -f "$TMP_ALL" "$TMP_STAGED" "$TMP_TO_RUN"' EXIT

collect_tests > "$TMP_ALL"

if [ ! -s "$TMP_ALL" ]; then
    echo "No Python unit tests found. Commit can proceed."
    exit 0
fi

while IFS= read -r test_file; do
    [ -z "$test_file" ] && continue
    if echo "$STAGED_FILES" | grep -qxF "$test_file" 2>/dev/null; then
        echo "$test_file" >> "$TMP_STAGED"
    fi
done < "$TMP_ALL"

if [ -s "$TMP_STAGED" ]; then
    echo "Running staged Python tests..."
    while IFS= read -r test_file; do
        [ -z "$test_file" ] && continue
        run_python_test "$test_file" || exit 1
    done < "$TMP_STAGED"
else
    echo "No staged Python test files found."
fi

echo "Running random Python tests (ratio=${TEST_RATIO}%)..."
while IFS= read -r test_file; do
    [ -z "$test_file" ] && continue
    if [ -s "$TMP_STAGED" ] && grep -qxF "$test_file" "$TMP_STAGED" 2>/dev/null; then
        continue
    fi
    random_num=$((RANDOM % 100))
    if [ "$random_num" -lt "$TEST_RATIO" ]; then
        echo "$test_file" >> "$TMP_TO_RUN"
    fi
done < "$TMP_ALL"

if [ ! -s "$TMP_TO_RUN" ]; then
    TMP_NON_STAGED="$(mktemp)"
    while IFS= read -r test_file; do
        [ -z "$test_file" ] && continue
        if [ -s "$TMP_STAGED" ] && grep -qxF "$test_file" "$TMP_STAGED" 2>/dev/null; then
            continue
        fi
        echo "$test_file" >> "$TMP_NON_STAGED"
    done < "$TMP_ALL"
    if [ -s "$TMP_NON_STAGED" ]; then
        line_count=$(wc -l < "$TMP_NON_STAGED" | tr -d ' ')
        random_line=$((RANDOM % line_count + 1))
        FALLBACK_TEST=$(sed -n "${random_line}p" "$TMP_NON_STAGED")
        echo "$FALLBACK_TEST" >> "$TMP_TO_RUN"
        echo "(No test selected by random; running one at random: $FALLBACK_TEST)"
    fi
    rm -f "$TMP_NON_STAGED"
fi

while IFS= read -r test_file; do
    [ -z "$test_file" ] && continue
    run_python_test "$test_file" || exit 1
done < "$TMP_TO_RUN"

echo "All Python tests passed. Commit can proceed."
